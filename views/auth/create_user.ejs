<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <% if (invitation_url) { %>
        <div class="alert alert-success reveal-group">
            <div class="fw-semibold mb-1">Invitation créée</div>
            <p class="mb-2 small text-muted">Transmettez ce lien à l'utilisateur. Valable 72 heures, à usage unique.</p>
            <div class="input-group">
                <input class="form-control" type="text" readonly value="<%= invitation_url %>" id="invitation-url"
                    aria-label="Lien d'invitation">
                <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('invitation-url').value); this.innerText='Copié !';">
                    <i class="bi bi-clipboard me-1" aria-hidden="true"></i>Copier
                </button>
            </div>
        </div>
        <% } %>

        <div class="card shadow-sm">
            <div class="card-body">
                <span class="kicker">Administration</span>
                <h1 class="page-title mb-4">Création de compte utilisateur</h1>
                <form method="post" action="/auth/users/new">
                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                    <div class="mb-3">
                        <label class="form-label" for="full_name">Nom complet</label>
                        <input class="form-control" id="full_name" name="full_name" required maxlength="120" placeholder="Ex: Hélène Lambert">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" id="email" type="email" name="email" required maxlength="254" placeholder="helene.lambert@edulink.local">
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="role">Rôle</label>
                        <select class="form-select" id="role" name="role" required>
                            <option value="PARENT">PARENT</option>
                            <option value="TEACHER">TEACHER</option>
                            <option value="ADMIN">ADMIN</option>
                        </select>
                        <small class="form-text text-muted">L'utilisateur recevra un lien ou pourra se connecter directement avec son mot de passe initial.</small>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/admin/members" class="btn btn-outline-secondary">Annuler</a>
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Créer le compte
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
