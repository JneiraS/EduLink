<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-end mb-4 gap-3 flex-wrap reveal-group">
    <div>
        <span class="kicker">Administration</span>
        <h1 class="page-title">Statistiques d'utilisation</h1>
    </div>
    <span class="text-muted small">Mises à jour en direct</span>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="card-title h5">
                    <i class="bi bi-person-plus-fill me-2 text-primary" aria-hidden="true"></i>
                    Inscriptions par semaine
                </h2>
                <div class="chart-box" style="position: relative; height: 260px;">
                    <canvas id="chart-registrations" data-chart='<%- JSON.stringify(stats.registrations_by_week) %>'></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="card-title h5">
                    <i class="bi bi-people-fill me-2 text-info" aria-hidden="true"></i>
                    Utilisateurs par rôle
                </h2>
                <div class="chart-box" style="position: relative; height: 260px;">
                    <canvas id="chart-users-by-role" data-chart='<%- JSON.stringify(stats.users_by_role) %>'></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="card-title h5">
                    <i class="bi bi-chat-left-text-fill me-2 text-secondary" aria-hidden="true"></i>
                    Messages par jour (2 dernières semaines)
                </h2>
                <div class="chart-box" style="position: relative; height: 260px;">
                    <canvas id="chart-messages-by-day" data-chart='<%- JSON.stringify(stats.messages_by_day) %>'></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="card-title h5">
                    <i class="bi bi-hash me-2 text-success" aria-hidden="true"></i>
                    Canaux les plus actifs
                </h2>
                <div class="chart-box" style="position: relative; height: 260px;">
                    <canvas id="chart-top-channels" data-chart='<%- JSON.stringify(stats.top_channels) %>'></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="card-title h5">
                    <i class="bi bi-megaphone-fill me-2 text-warning" aria-hidden="true"></i>
                    Lecture des annonces récentes
                </h2>
                <div class="chart-box" style="position: relative; height: 260px;">
                    <canvas id="chart-read-rates" data-chart='<%- JSON.stringify(stats.announcement_read_rates) %>'></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="card-title h5">
                    <i class="bi bi-bell-fill me-2 text-danger" aria-hidden="true"></i>
                    Adoption des notifications
                </h2>
                <div class="chart-box" style="position: relative; height: 260px;">
                    <canvas id="chart-push-adoption" data-chart='<%- JSON.stringify(stats.push_adoption) %>'></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="/static/js/admin-charts.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof renderAdminCharts === 'function') {
            renderAdminCharts();
        }
    });
</script>

<%- include('../partials/footer') %>
