<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a href="/parent/children" class="btn btn-outline-secondary mb-2">
            <i class="bi bi-arrow-left me-2"></i>Retour
        </a>
        <h1><i class="bi bi-person me-2"></i><%= child.full_name %> <span class="text-muted fs-5">(<%= child.class_name %>)</span></h1>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-transparent fw-semibold">
        Canaux associés à la classe <%= child.class_name %>
    </div>
    <div class="card-body">
        <% if (channels && channels.length > 0) { %>
            <div class="list-group">
                <% channels.forEach(function(channel) { %>
                <a href="/messages/channels/<%= channel.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                    <div>
                        <i class="bi bi-hash me-2 text-primary"></i>
                        <strong><%= channel.name %></strong>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary border">Classe</span>
                </a>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-5 text-muted">
                <i class="bi bi-hash fs-1"></i>
                <p class="mt-2">Aucun canal spécifique trouvé pour la classe <%= child.class_name %>.</p>
                <p class="small">L'équipe pédagogique ouvrira bientôt les échanges de classe.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
