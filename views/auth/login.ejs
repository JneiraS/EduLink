<%- include('../partials/header') %>

<div class="auth-screen d-flex align-items-center justify-content-center py-5">
    <div class="auth-card" style="max-width: 440px; width: 100%;">
        <div class="auth-panel p-4 p-md-5 rounded-4 border shadow-sm bg-surface">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h1 class="h4 fw-bold text-body mb-1">Bienvenue sur EduLink</h1>
                <p class="text-muted small mb-0">Espace de communication officiel de l'école</p>
            </div>

            <form method="post" action="/auth/login" class="mb-4">
                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-body" for="email">Adresse email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light-subtle border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input class="form-control border-start-0 ps-0" id="email" type="email" name="email" required
                            placeholder="nom@edulink.local" autocomplete="username">
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-body mb-0" for="password">Mot de passe</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light-subtle border-end-0 text-muted"><i class="bi bi-key"></i></span>
                        <input class="form-control border-start-0 ps-0" id="password" type="password" name="password"
                            required autocomplete="current-password" placeholder="••••••••">
                    </div>
                </div>
                <button class="btn btn-primary w-100 py-2 shadow-sm fw-semibold" type="submit">
                    Se connecter à mon espace
                </button>
            </form>

            <div class="border-top pt-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">Accès rapide démo</span>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis" style="font-size: 0.65rem;">1 clic</span>
                </div>
                <div class="d-grid gap-2">
                    <form method="post" action="/auth/quick-login" class="m-0">
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <input type="hidden" name="role" value="ADMIN">
                        <button class="btn btn-sm btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-2" type="submit">
                            <span class="role-badge-dot role-badge-dot--admin"></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-dark" style="font-size: 0.82rem;">Espace Administration</div>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">admin@edulink.local</small>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                        </button>
                    </form>
                    <form method="post" action="/auth/quick-login" class="m-0">
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <input type="hidden" name="role" value="TEACHER">
                        <button class="btn btn-sm btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-2" type="submit">
                            <span class="role-badge-dot role-badge-dot--teacher"></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-dark" style="font-size: 0.82rem;">Espace Enseignante (Claire Dupont)</div>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">claire.dupont@edulink.local</small>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                        </button>
                    </form>
                    <form method="post" action="/auth/quick-login" class="m-0">
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <input type="hidden" name="role" value="PARENT">
                        <button class="btn btn-sm btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-2" type="submit">
                            <span class="role-badge-dot role-badge-dot--parent"></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-dark" style="font-size: 0.82rem;">Espace Parent (Marc Martin)</div>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">marc.martin@edulink.local</small>
                            </div>
                            <i class="bi bi-arrow-right text-muted"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
