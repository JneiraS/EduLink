# ---------------------------------------------------------------------------
# EduLink production environment template.
#
# docker compose interpolates this file (it lives next to docker-compose.yml
# on the server, at /opt/edulink/.env) and injects the plain vars into the
# web container via env_file. Secrets live HERE on the server only — they
# never reach GitHub, the image, or the CI logs.
#
# Setup: cp .env.production.example .env  (on the server) then edit.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
# REQUIRED — compose refuses to start without it.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_USER=edulink
POSTGRES_DB=edulink

# --- Admin dashboard account (seeded on first boot if absent) -------------
EDULINK_ADMIN_EMAIL=admin@edulink.local
EDULINK_ADMIN_PASSWORD=change-me-admin-password

# --- Session key ----------------------------------------------------------
# If left empty, a stable key is auto-generated and persisted inside the
# instance/ volume, so sessions survive restarts either way. Explicit is safer.
SECRET_KEY=

# --- Web Push (VAPID) -----------------------------------------------------
# Generate once with:  npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@edulink.local

# --- Optional -------------------------------------------------------------
# EDULINK_PORT: host port published by compose (default 5050)
EDULINK_PORT=5050
# SESSION_LIFETIME_SECONDS: session lifetime in production (default 12h)
SESSION_LIFETIME_SECONDS=43200
# Ollama AI assistant (student data never leaves the school network)
OLLAMA_BASE_URL=http://192.168.1.28:11434
OLLAMA_MODEL=llama3.2:3b