<%- include('../partials/header') %>

<div class="row justify-content-center reveal-group">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <span class="kicker">Messagerie</span>
                <h1 class="page-title mb-2">Nouvelle conversation</h1>
                <p class="text-muted mb-4">Choisissez un contact pour lancer une conversation privée.</p>
                <form method="post" action="/messages/new">
                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                    <% if (users && users.length > 0) { %>
                    <fieldset class="mb-4">
                        <legend class="h6 mb-2">Contacts disponibles</legend>
                        <div class="d-flex flex-column gap-2">
                            <% users.forEach(function(user) { %>
                            <label class="member-option border rounded p-2 d-flex align-items-center gap-3 cursor-pointer" for="contact_<%= user.id %>">
                                <input class="form-check-input" type="radio" name="member" value="<%= user.id %>"
                                    id="contact_<%= user.id %>" required>
                                <span class="avatar avatar-sm"><%= user.full_name ? user.full_name[0].toUpperCase() : 'U' %></span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold"><%= user.full_name %></div>
                                    <small class="text-muted"><%= user.role %> - <%= user.email %></small>
                                </div>
                            </label>
                            <% }); %>
                        </div>
                    </fieldset>
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/messages" class="btn btn-outline-secondary">Annuler</a>
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-chat-dots me-2" aria-hidden="true"></i>Démarrer la conversation
                        </button>
                    </div>
                    <% } else { %>
                    <p class="text-muted mb-0">Aucun autre utilisateur disponible pour le moment.</p>
                    <% } %>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
