<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-end mb-4 gap-3 flex-wrap reveal-group">
    <div>
        <span class="kicker">Administration</span>
        <h1 class="page-title">Gestion des membres</h1>
    </div>
    <a class="btn btn-primary" href="/auth/users/new">
        <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Créer un utilisateur
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <% if (users && users.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th scope="col">Membre</th>
                        <th scope="col">Rôle</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(u) { %>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-sm"><%= u.full_name ? u.full_name[0].toUpperCase() : 'U' %></span>
                                <div>
                                    <div class="fw-semibold"><%= u.full_name %></div>
                                    <small class="text-muted"><%= u.email %></small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <form method="post" action="/admin/members/<%= u.id %>/role" class="d-inline-flex align-items-center gap-2">
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <select name="role" class="form-select form-select-sm role-select">
                                    <option value="ADMIN" <%= u.role === 'ADMIN' ? 'selected' : '' %>>ADMIN</option>
                                    <option value="TEACHER" <%= u.role === 'TEACHER' ? 'selected' : '' %>>TEACHER</option>
                                    <option value="PARENT" <%= u.role === 'PARENT' ? 'selected' : '' %>>PARENT</option>
                                </select>
                                <button class="btn btn-sm btn-outline-secondary" type="submit" title="Appliquer le rôle">
                                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                        <td>
                            <span class="badge text-bg-success">Actif</span>
                        </td>
                        <td class="text-end">
                            <% if (u.id !== current_user.id) { %>
                            <form method="post" action="/admin/members/<%= u.id %>/delete" class="d-inline">
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Supprimer cet utilisateur ?')">
                                    <i class="bi bi-trash me-1"></i>Supprimer
                                </button>
                            </form>
                            <% } else { %>
                            <span class="badge text-bg-light border">Vous</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="empty-state text-center py-4">
            <span class="empty-icon text-muted fs-3"><i class="bi bi-people"></i></span>
            <div class="empty-title fw-semibold mt-2">Aucun membre</div>
            <div class="empty-hint text-muted small">Les comptes créés apparaîtront ici.</div>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
