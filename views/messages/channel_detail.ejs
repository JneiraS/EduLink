<%- include('../partials/header') %>

<div class="row g-4">
    <div class="col-lg-<%= channel.kind === 'direct' ? '12' : '8' %>">
        <div class="card shadow-sm border-0 chat-window h-100">
            <div class="card-body p-4 d-flex flex-column" style="min-height: 580px;">
                <!-- Chat Header -->
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <a href="/messages" class="btn btn-outline-secondary btn-sm" title="Retour aux canaux">
                            <i class="bi bi-arrow-left"></i>
                        </a>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle <%= channel.kind === 'direct' ? 'bg-primary-subtle text-primary' : 'bg-secondary-subtle text-secondary' %>" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                    <i class="bi <%= channel.kind === 'direct' ? 'bi-person-fill' : 'bi-hash' %>"></i>
                                </span>
                                <h1 class="h5 fw-bold mb-0 text-body"><%= channel.name %></h1>
                                <span class="badge bg-light text-muted border" style="font-size: 0.72rem;"><%= members.length %> participant<%= members.length !== 1 ? 's' : '' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Header actions: AI Summary button -->
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm" id="btn-ai-summary" type="button" title="Générer un résumé IA de la conversation">
                            <i class="bi bi-stars"></i> Résumé IA
                        </button>
                    </div>
                </div>

                <!-- AI Summary Banner (Hidden by default, shown when generated) -->
                <div id="ai-summary-card" class="alert alert-info border shadow-sm p-3 mb-3 d-none">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="fw-bold d-flex align-items-center gap-1 text-primary">
                            <i class="bi bi-stars"></i> Synthèse intelligente de la discussion
                        </div>
                        <button type="button" class="btn-close btn-sm" id="close-ai-summary" aria-label="Fermer"></button>
                    </div>
                    <div id="ai-summary-text" class="small text-dark" style="white-space: pre-line; line-height: 1.5;"></div>
                </div>

                <!-- Pinned Messages Bar -->
                <% if (pinned_messages && pinned_messages.length > 0) { %>
                <div class="p-2 mb-3 bg-light-subtle rounded border d-flex align-items-start gap-2">
                    <i class="bi bi-pin-angle-fill text-warning mt-1"></i>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold small text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">Message épinglé</div>
                        <% pinned_messages.forEach(function(pm) { %>
                        <div class="small text-muted py-1 d-flex justify-content-between align-items-center">
                            <span class="text-truncate"><strong><%= pm.sender_name %> :</strong> <%= pm.content %></span>
                            <form method="post" action="/messages/channels/<%= channel.id %>/messages/<%= pm.id %>/pin" class="m-0 ms-2">
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <button type="submit" class="btn btn-link btn-sm p-0 text-muted" title="Désépingler">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- Message stream -->
                <div class="chat-messages flex-grow-1 mb-3 pe-2" id="messages-container" style="min-height: 320px; max-height: 480px; overflow-y: auto;">
                    <% if (messages && messages.length > 0) { %>
                        <% messages.forEach(function(msg) { %>
                        <% const isOwn = msg.sender_id === current_user.id; %>
                        <div class="d-flex mb-3 gap-2 <%= isOwn ? 'flex-row-reverse' : '' %> group-message">
                            <% 
                               const senderUser = members.find(m => m.id === msg.sender_id);
                               const senderRole = senderUser ? senderUser.role.toLowerCase() : 'admin';
                            %>
                            <span class="avatar avatar-sm avatar--<%= senderRole %> flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.8rem;" title="<%= msg.sender_name %>">
                                <%= msg.sender_name ? msg.sender_name[0].toUpperCase() : 'U' %>
                            </span>
                            <div class="message-bubble p-3 <%= isOwn ? 'bubble-sent' : 'bubble-received' %> position-relative" style="max-width: 78%;">
                                <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                    <strong class="small <%= isOwn ? 'text-white' : 'text-dark' %>" style="font-size: 0.82rem;"><%= msg.sender_name %></strong>
                                    <small class="<%= isOwn ? 'text-white-50' : 'text-muted' %>" style="font-size: 0.72rem;">
                                        <%= msg.created_at ? new Date(msg.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '' %>
                                    </small>
                                </div>
                                <div style="font-size: 0.92rem; line-height: 1.45; word-break: break-word;"><%= msg.content %></div>
                                <div class="d-flex align-items-center justify-content-between mt-1 pt-1 border-top <%= isOwn ? 'border-white-50' : 'border-light-subtle' %>" style="font-size: 0.72rem;">
                                    <% if (msg.is_pinned) { %>
                                    <span class="<%= isOwn ? 'text-white' : 'text-warning' %> fw-semibold">
                                        <i class="bi bi-pin-fill me-1"></i>Épinglé
                                    </span>
                                    <% } else { %>
                                    <span></span>
                                    <% } %>
                                    <form method="post" action="/messages/channels/<%= channel.id %>/messages/<%= msg.id %>/pin" class="m-0 d-inline">
                                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                        <button type="submit" class="btn btn-link btn-sm p-0 <%= isOwn ? 'text-white-50' : 'text-muted' %> text-decoration-none" title="<%= msg.is_pinned ? 'Désépingler' : 'Épingler ce message' %>">
                                            <i class="bi <%= msg.is_pinned ? 'bi-pin-fill' : 'bi-pin' %>"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-chat-dots fs-1 d-block mb-2 text-secondary"></i>
                        <p class="mb-0 fw-medium">Aucun message pour l'instant.</p>
                        <small>Posez une question ou partagez une information avec les participants.</small>
                    </div>
                    <% } %>
                </div>

                <!-- Composer -->
                <div class="chat-composer border-top pt-3">
                    <!-- Quick templates and AI rephrase toolbar -->
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <% if (templates && templates.length > 0) { %>
                            <div class="dropdown">
                                <button class="btn btn-xs btn-outline-secondary dropdown-toggle" style="font-size: 0.78rem;" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-lightning-charge me-1"></i>Modèles de réponse
                                </button>
                                <ul class="dropdown-menu shadow-sm">
                                    <% templates.forEach(function(tpl) { %>
                                    <li>
                                        <button class="dropdown-item py-2" type="button" onclick="insertTemplate(<%= JSON.stringify(tpl.content) %>)">
                                            <strong class="d-block text-dark" style="font-size: 0.85rem;"><%= tpl.label %></strong>
                                            <small class="text-muted d-block text-truncate" style="max-width: 260px; font-size: 0.75rem;"><%= tpl.content %></small>
                                        </button>
                                    </li>
                                    <% }); %>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item small text-primary" href="/messages/templates">
                                            <i class="bi bi-gear me-1"></i>Gérer mes modèles
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <% } %>
                        </div>

                        <!-- AI Rephrase Button -->
                        <button type="button" class="btn btn-xs btn-outline-info d-inline-flex align-items-center gap-1" style="font-size: 0.78rem;" id="btn-ai-rephrase" title="Reformuler poliment votre ébauche">
                            <i class="bi bi-magic"></i> Reformuler poliment
                        </button>
                    </div>

                    <!-- AI Suggestion preview box (if rephrased) -->
                    <div id="ai-rephrase-box" class="alert alert-light border shadow-sm p-3 mb-2 d-none">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold text-info"><i class="bi bi-magic me-1"></i>Suggestion de reformulation polie :</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-primary py-0 px-2" style="font-size: 0.75rem;" id="btn-apply-rephrase">Appliquer</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" id="btn-cancel-rephrase">Ignorer</button>
                            </div>
                        </div>
                        <div id="ai-rephrase-content" class="small text-muted fst-italic" style="white-space: pre-line;"></div>
                    </div>

                    <form method="post" action="/messages/channels/<%= channel.id %>" id="chat-form" class="d-flex gap-2 align-items-end">
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <div class="flex-grow-1">
                            <textarea class="form-control" id="msg-input" name="content" rows="2" required
                                placeholder="Écrivez votre message ici... (Entrée pour envoyer, Maj+Entrée pour retour ligne)"
                                style="resize: none;"></textarea>
                        </div>
                        <button class="btn btn-primary px-3 py-2 shadow-sm d-flex align-items-center justify-content-center" type="submit" style="height: 54px; min-width: 54px;" title="Envoyer">
                            <i class="bi bi-send-fill fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Members sidebar if group channel -->
    <% if (channel.kind !== 'direct') { %>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-bold mb-0 text-body">Membres du canal</h2>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= members.length %></span>
                </div>
                <ul class="list-unstyled mb-0" style="max-height: 480px; overflow-y: auto;">
                    <% members.forEach(function(m) { %>
                    <li class="d-flex align-items-center gap-3 py-2 border-bottom">
                        <% 
                           const mParts = (m.full_name || '').split(' ');
                           const mInitials = (mParts[0] ? mParts[0][0] : '') + (mParts[1] ? mParts[1][0] : '');
                        %>
                        <span class="avatar avatar-sm avatar--<%= (m.role || '').toLowerCase() %>" style="width: 36px; height: 36px; font-size: 0.85rem;"><%= mInitials.toUpperCase() %></span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="small fw-bold text-truncate text-dark"><%= m.full_name %></div>
                            <span class="badge badge-role badge-role--<%= (m.role || '').toLowerCase() %>" style="font-size: 0.68rem;"><%= m.role %></span>
                        </div>
                    </li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </div>
    <% } %>
</div>

<script>
    // Auto-scroll chat to bottom
    window.addEventListener('load', function() {
        const c = document.getElementById('messages-container');
        if (c) c.scrollTop = c.scrollHeight;
    });

    // Enter to send (Shift+Enter for newline)
    const msgInput = document.getElementById('msg-input');
    if (msgInput) {
        msgInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (msgInput.value.trim().length > 0) {
                    document.getElementById('chat-form').submit();
                }
            }
        });
    }

    function insertTemplate(content) {
        const input = document.getElementById('msg-input');
        if (input) {
            input.value = content;
            input.focus();
        }
    }

    // AI Summary Button
    const btnAiSummary = document.getElementById('btn-ai-summary');
    const aiSummaryCard = document.getElementById('ai-summary-card');
    const aiSummaryText = document.getElementById('ai-summary-text');
    const closeAiSummary = document.getElementById('close-ai-summary');

    if (btnAiSummary) {
        btnAiSummary.addEventListener('click', async function() {
            btnAiSummary.disabled = true;
            btnAiSummary.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Génération...';
            try {
                const res = await fetch('/ai/channels/<%= channel.id %>/summary', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.summary) {
                    aiSummaryText.textContent = data.summary;
                    aiSummaryCard.classList.remove('d-none');
                } else if (data.error) {
                    alert(data.error);
                }
            } catch (err) {
                console.error(err);
                alert('Impossible de générer le résumé pour le moment.');
            } finally {
                btnAiSummary.disabled = false;
                btnAiSummary.innerHTML = '<i class="bi bi-stars"></i> Résumé IA';
            }
        });
    }

    if (closeAiSummary) {
        closeAiSummary.addEventListener('click', function() {
            aiSummaryCard.classList.add('d-none');
        });
    }

    // AI Rephrase Button
    const btnAiRephrase = document.getElementById('btn-ai-rephrase');
    const aiRephraseBox = document.getElementById('ai-rephrase-box');
    const aiRephraseContent = document.getElementById('ai-rephrase-content');
    const btnApplyRephrase = document.getElementById('btn-apply-rephrase');
    const btnCancelRephrase = document.getElementById('btn-cancel-rephrase');
    let suggestedRephrase = '';

    if (btnAiRephrase) {
        btnAiRephrase.addEventListener('click', async function() {
            const currentText = msgInput ? msgInput.value.trim() : '';
            if (!currentText) {
                alert('Veuillez taper une ébauche de message d’abord.');
                return;
            }
            btnAiRephrase.disabled = true;
            btnAiRephrase.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Réécriture...';
            try {
                const res = await fetch('/ai/rephrase', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: currentText })
                });
                const data = await res.json();
                if (data.rephrased) {
                    suggestedRephrase = data.rephrased;
                    aiRephraseContent.textContent = suggestedRephrase;
                    aiRephraseBox.classList.remove('d-none');
                } else if (data.error) {
                    alert(data.error);
                }
            } catch (err) {
                console.error(err);
                alert('Service indisponible.');
            } finally {
                btnAiRephrase.disabled = false;
                btnAiRephrase.innerHTML = '<i class="bi bi-magic"></i> Reformuler poliment';
            }
        });
    }

    if (btnApplyRephrase) {
        btnApplyRephrase.addEventListener('click', function() {
            if (msgInput && suggestedRephrase) {
                msgInput.value = suggestedRephrase;
                aiRephraseBox.classList.add('d-none');
                msgInput.focus();
            }
        });
    }

    if (btnCancelRephrase) {
        btnCancelRephrase.addEventListener('click', function() {
            aiRephraseBox.classList.add('d-none');
        });
    }
</script>

<%- include('../partials/footer') %>
