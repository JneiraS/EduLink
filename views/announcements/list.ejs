<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-end mb-4 gap-3 flex-wrap">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Circulaires & Infos</span>
            <span class="text-muted small">• Espace officiel</span>
        </div>
        <h1 class="h3 fw-bold mb-0 text-body">Annonces scolaires</h1>
    </div>
    <% if (current_user.role === 'ADMIN' || current_user.role === 'TEACHER') { %>
    <a class="btn btn-primary shadow-sm d-inline-flex align-items-center gap-2" href="/announcements/new">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Publier une annonce
    </a>
    <% } %>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <% if (announcements && announcements.length > 0) { %>
            <div class="d-flex flex-column gap-4">
                <% announcements.forEach(function(a) { %>
                <article class="p-4 rounded-3 border announcement-card <%= a.is_read ? 'announcement-card--read bg-surface' : 'bg-light-subtle' %>">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <% if (a.channel_name) { %>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                                <i class="bi bi-hash me-1"></i><%= a.channel_name %>
                            </span>
                            <% } else { %>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                <i class="bi bi-globe me-1"></i>Toute l'école
                            </span>
                            <% } %>
                            
                            <span class="text-muted small d-inline-flex align-items-center gap-1">
                                <i class="bi bi-calendar3"></i>
                                <%= a.created_at ? new Date(a.created_at).toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %>
                            </span>
                        </div>

                        <div>
                            <% if (a.is_read) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check2-circle me-1"></i>Lecture confirmée
                            </span>
                            <% } else { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                <i class="bi bi-exclamation-circle me-1"></i>À signer / confirmer
                            </span>
                            <% } %>
                        </div>
                    </div>

                    <h2 class="h5 fw-bold mb-2 text-body"><%= a.title %></h2>
                    <p class="text-muted mb-3" style="line-height: 1.6; font-size: 0.95rem; white-space: pre-line;"><%= a.content %></p>

                    <% if (a.pdf_filename) { %>
                    <div class="mb-3">
                        <a class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-2 shadow-sm"
                            href="/static/<%= a.pdf_filename %>" download>
                            <i class="bi bi-file-earmark-pdf-fill fs-5" aria-hidden="true"></i>
                            <span>Consulter la pièce jointe (PDF)</span>
                        </a>
                    </div>
                    <% } %>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top gap-3 flex-wrap">
                        <div class="small text-muted d-flex align-items-center gap-2">
                            <span class="avatar avatar-sm avatar--admin" style="width: 26px; height: 26px; font-size: 0.7rem;">
                                <%= (a.author_name || 'D')[0].toUpperCase() %>
                            </span>
                            <span>Signé par <strong><%= a.author_name || 'Direction de l’établissement' %></strong></span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <% if (current_user.role === 'ADMIN' || current_user.role === 'TEACHER') { %>
                            <span class="badge bg-light text-muted border">
                                <i class="bi bi-people me-1"></i>Lu par 80% des familles
                            </span>
                            <% } %>

                            <% if (!a.is_read) { %>
                            <form method="post" action="/announcements/<%= a.id %>/read" class="d-inline m-0">
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-sm" type="submit">
                                    <i class="bi bi-check2"></i> Confirmer la lecture
                                </button>
                            </form>
                            <% } %>
                        </div>
                    </div>
                </article>
                <% }); %>
            </div>
        <% } else { %>
        <div class="text-center py-5 text-muted">
            <i class="bi bi-megaphone fs-1 d-block mb-2 text-secondary"></i>
            <h3 class="h5 fw-bold text-dark">Aucune annonce scolaire</h3>
            <p class="small text-muted">Les notes de service et circulaires publiées apparaîtront ici.</p>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
