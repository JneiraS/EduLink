<%- include('../partials/header') %>

<div class="row justify-content-center reveal-group">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <span class="kicker">Messagerie</span>
                <h1 class="page-title mb-4">Mes modèles de messages</h1>
                <form method="post" action="/messages/templates" class="mb-4">
                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                    <div class="mb-3">
                        <label class="form-label" for="label">Nom du modèle</label>
                        <input class="form-control" id="label" name="label" required maxlength="80"
                            placeholder="Ex. Rappel devoir ou réunion">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="content">Contenu</label>
                        <textarea class="form-control" id="content" name="content" rows="4" required
                            maxlength="5000" placeholder="Votre texte réutilisable..."></textarea>
                    </div>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Enregistrer le modèle
                    </button>
                </form>

                <% if (templates && templates.length > 0) { %>
                <div class="list-group">
                    <% templates.forEach(function(template) { %>
                    <div class="list-group-item d-flex align-items-center gap-3 border rounded-3 mb-2 p-3">
                        <div class="me-auto">
                            <div class="fw-semibold"><%= template.label %></div>
                            <small class="text-muted"><%= template.content %></small>
                        </div>
                        <form method="post" action="/messages/templates/<%= template.id %>/delete" class="d-inline">
                            <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                onclick="return confirm('Supprimer ce modèle ?')">Supprimer</button>
                        </form>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="empty-state text-center py-4">
                    <span class="empty-icon text-muted fs-3"><i class="bi bi-file-earmark-text"></i></span>
                    <div class="empty-title fw-semibold mt-2">Aucun modèle</div>
                    <div class="empty-hint text-muted small">Créez des modèles pour réutiliser vos messages fréquents.</div>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
