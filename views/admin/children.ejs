<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people-fill me-2"></i>Gestion des enfants</h1>
    <a href="/admin/members" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Retour aux membres
    </a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-transparent fw-semibold">
        Ajouter un enfant
    </div>
    <div class="card-body">
        <form method="post" action="/admin/children" class="row g-3">
            <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
            <div class="col-md-4">
                <label for="parent_id" class="form-label">Parent <span class="text-danger">*</span></label>
                <select class="form-select" id="parent_id" name="parent_id" required>
                    <option value="">Sélectionner un parent</option>
                    <% parents.forEach(function(p) { %>
                    <option value="<%= p.id %>"><%= p.full_name %> (<%= p.email %>)</option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-4">
                <label for="full_name" class="form-label">Nom complet de l'enfant <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="full_name" name="full_name" maxlength="120" required placeholder="Prénom Nom">
            </div>
            <div class="col-md-3">
                <label for="class_name" class="form-label">Classe <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="class_name" name="class_name" maxlength="120" required placeholder="ex: CM2-A, CE1-B">
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100" title="Ajouter">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-transparent fw-semibold">
        Enfants rattachés
    </div>
    <div class="card-body">
        <% if (children && children.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Enfant</th>
                        <th>Classe</th>
                        <th>Parent</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% children.forEach(function(c) { %>
                    <tr>
                        <td>
                            <span class="avatar avatar-sm me-2"><%= c.full_name ? c.full_name[0].toUpperCase() : 'E' %></span>
                            <strong><%= c.full_name %></strong>
                        </td>
                        <td><span class="badge text-bg-light border"><%= c.class_name %></span></td>
                        <td><%= c.parent_name %> (<%= c.parent_email %>)</td>
                        <td class="text-end">
                            <form method="post" action="/admin/children/<%= c.id %>/delete" class="d-inline">
                                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer cet enfant ?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people fs-1"></i>
            <p class="mt-2">Aucun enfant rattaché pour le moment.</p>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
